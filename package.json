{
  "name": "hanzi-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run sync:hanzi-data && node scripts/clean-sites-build.mjs && node scripts/build-provenance.mjs start && vinext build && node scripts/build-provenance.mjs finish && node scripts/check-bundle-budget.mjs",
    "start": "vinext start",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:content": "vitest run src/data/assessment.test.ts src/data/contentValidation.test.ts src/data/releasePolicy.test.ts src/data/productionReadiness.test.ts src/content/packageGovernance.test.ts src/content/currentPackage.test.ts src/content/contentCommand.test.ts src/content/characterSourceProvenance.test.ts src/content/editorialReadiness.test.ts src/content/editorialAssignments.test.ts",
    "content:hash": "node scripts/content/hash.mjs",
    "content:catalog:export": "tsx scripts/content/export-item-catalog.ts",
    "content:validate": "node scripts/content/validate.mjs",
    "content:hsk4:extract": "python scripts/content/extract-hsk-syllabus.py",
    "content:hsk4:validate": "node scripts/content/validate-hsk-syllabus.mjs",
    "content:hsk4:report": "node scripts/content/report-hsk4-coverage.mjs",
    "content:hsk4:graph:validate": "node scripts/content/validate-hsk-curriculum-graph.mjs",
    "content:hsk0:pronunciation": "node scripts/content/build-hsk0-pronunciation-bootcamp.mjs",
    "content:hsk0:pronunciation:validate": "node scripts/content/validate-hsk0-pronunciation-bootcamp.mjs",
    "content:hsk1:import": "node scripts/content/import-hsk1-cedict.mjs",
    "content:hsk1:validate": "node scripts/content/validate-hsk1-vocabulary-draft.mjs",
    "content:hsk1:report": "node scripts/content/report-hsk1-content-backlog.mjs",
    "content:hsk1:scope": "node scripts/content/build-hsk1-curriculum-scope.mjs",
    "content:hsk1:scope:validate": "node scripts/content/validate-hsk1-curriculum-scope.mjs",
    "content:hsk1:personal-pack": "node scripts/content/build-hsk1-personal-exchange-pack.mjs",
    "content:hsk1:personal-pack:validate": "node scripts/content/validate-hsk1-personal-exchange-pack.mjs",
    "content:hsk1:communicative-packs": "node scripts/content/build-hsk1-communicative-unit-packs.mjs",
    "content:hsk1:communicative-packs:validate": "node scripts/content/validate-hsk1-communicative-unit-packs.mjs",
    "content:hsk1:character-pack": "node scripts/content/build-hsk1-character-foundation-pack.mjs",
    "content:hsk1:character-pack:validate": "node scripts/content/validate-hsk1-character-foundation-pack.mjs",
    "content:hsk1:grammar-pack": "node scripts/content/build-hsk1-grammar-context-pack.mjs",
    "content:hsk1:grammar-pack:validate": "node scripts/content/validate-hsk1-grammar-context-pack.mjs",
    "content:hsk1:task-pack": "node scripts/content/build-hsk1-task-assessment-pack.mjs",
    "content:hsk1:task-pack:validate": "node scripts/content/validate-hsk1-task-assessment-pack.mjs",
    "content:hsk1:level-check-bank": "node scripts/content/build-hsk1-level-check-item-bank.mjs",
    "content:hsk1:level-check-bank:validate": "node scripts/content/validate-hsk1-level-check-item-bank.mjs",
    "content:hsk1:review-manifest": "node scripts/content/build-hsk1-review-manifest.mjs",
    "content:hsk1:review-manifest:validate": "node scripts/content/validate-hsk1-review-manifest.mjs",
    "content:hsk1:review:list": "node scripts/content/hsk1-review.mjs list",
    "content:hsk1:review:export": "node scripts/content/hsk1-review.mjs export",
    "content:hsk1:review:import": "node scripts/content/hsk1-review.mjs import",
    "content:hsk1:review-workflow:validate": "node scripts/content/hsk1-review.mjs validate",
    "content:hsk2:scope": "node scripts/content/build-hsk2-curriculum-scope.mjs",
    "content:hsk2:scope:validate": "node scripts/content/validate-hsk2-curriculum-scope.mjs",
    "content:report": "node scripts/content/report.mjs",
    "content:verify-alpha": "node scripts/content/verify-release.mjs --channel closed-alpha",
    "content:verify-release": "node scripts/content/verify-release.mjs --channel production",
    "content:new-version": "node scripts/content/new-version.mjs",
    "content:audio:import": "node scripts/content/import-audio.mjs",
    "content:character:import": "node scripts/content/import-character-metadata.mjs",
    "content:submit-review": "node scripts/content/submit-review.mjs",
    "content:promote": "node scripts/content/promote.mjs",
    "test:e2e": "npm run build && playwright test",
    "e2e:install-browsers": "playwright install --with-deps chromium",
    "test:lighthouse": "node scripts/check-lighthouse.mjs",
    "serve:e2e": "node scripts/serve-production-e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test:restore": "node scripts/rehearse-d1-restore.mjs",
    "sync:hanzi-data": "node scripts/sync-hanzi-data.mjs",
    "verify:lockfile": "node scripts/verify-lockfile-policy.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "release:evidence:production": "node scripts/generate-release-evidence.mjs --require-source-revision --source-revision-from-head --rebuild-from-source",
    "check": "npm run verify:lockfile && npm run typecheck && npm run lint && npm run content:validate && npm run content:hsk4:validate && npm run content:hsk4:graph:validate && npm run content:hsk0:pronunciation -- --check && npm run content:hsk0:pronunciation:validate && npm run content:hsk1:scope -- --check && npm run content:hsk1:scope:validate && npm run content:hsk1:personal-pack -- --check && npm run content:hsk1:personal-pack:validate && npm run content:hsk1:communicative-packs -- --check && npm run content:hsk1:communicative-packs:validate && npm run content:hsk1:character-pack -- --check && npm run content:hsk1:character-pack:validate && npm run content:hsk1:grammar-pack -- --check && npm run content:hsk1:grammar-pack:validate && npm run content:hsk1:task-pack -- --check && npm run content:hsk1:task-pack:validate && npm run content:hsk1:level-check-bank -- --check && npm run content:hsk1:level-check-bank:validate && npm run content:hsk1:review-manifest -- --check && npm run content:hsk1:review-manifest:validate && npm run content:hsk1:review-workflow:validate && npm run content:hsk2:scope -- --check && npm run content:hsk2:scope:validate && npm run content:hsk4:report -- --check && npm run content:hsk1:validate && npm run content:hsk1:report -- --check && npm run db:check && npm run test:restore && npm run test && npm run build",
    "verify:production": "node scripts/verify-production-readiness.mjs && npm run content:verify-release && npm run check && npm run test:e2e && npm run test:lighthouse && npm audit --omit=dev && npm run release:evidence:production && node scripts/verify-production-readiness.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hanzi-writer": "^3.7.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "ts-fsrs": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "hanzi-writer-data": "^2.0.1",
    "lighthouse": "^12.8.2",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.64.0",
    "tsx": "^4.23.1",
    "vinext": "0.0.50",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
